# VisiMind Backend Environment
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for live LLM probing)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Database path (default: ./visimind.db)
DATABASE_URL=sqlite+aiosqlite:///./visimind.db

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
